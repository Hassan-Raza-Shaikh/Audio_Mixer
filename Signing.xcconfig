// Code-signing configuration for Aura.
//
// By default the app is signed ad-hoc ("-"), which always works but means
// macOS re-issues a new signature on every rebuild — so TCC permissions
// (Screen Recording, Microphone) have to be re-granted each time.
//
// To make permissions stick across rebuilds, run:
//     ./scripts/setup-local-signing.sh
// It creates a stable self-signed identity ("Aura Local Signing") and writes
// Local.xcconfig (git-ignored) overriding AURA_CODE_SIGN_IDENTITY below.

AURA_CODE_SIGN_IDENTITY = -

// Optional per-machine override (created by the setup script). Keeps the
// identity name out of version control.
#include? "Local.xcconfig"

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = $(AURA_CODE_SIGN_IDENTITY)
